# ─── KanFlow API environment ───────────────────────────────
# Copy this file to `.env` and fill in real values.

# Port the API listens on
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/kanflow
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/kanflow
MONGO_URI=mongodb://127.0.0.1:27017/kanflow

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d

# Origin allowed by CORS (your frontend URL)
CLIENT_URL=http://localhost:5173
